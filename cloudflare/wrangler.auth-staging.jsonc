{
  "name": "returntrail-auth-staging",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-21",
  "vars": {
    "GOOGLE_CLIENT_ID": "334652903946-1ecpserb1b2cup673biim0a9pnuft1o0.apps.googleusercontent.com",
    "GITHUB_CLIENT_ID": "Ov23liZU74Hx4JdU6rXH",
    "AUTH_ENABLED": "true",
    "ACCOUNT_FRONTEND_ENABLED": "true",
    "GOOGLE_CUSTOMER_SIGNUP": "true"
  },
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "returntrail-auth-staging",
      "database_id": "cac6f0ae-732e-42b4-b624-6dc3c9217b22",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  }
}
