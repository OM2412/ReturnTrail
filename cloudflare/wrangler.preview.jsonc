{
  "name": "returntrail-preview-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "returntrail-preview",
      "database_id": "2e0842e5-55ba-4d20-aa9c-d8dd31080560",
      "migrations_dir": "migrations"
    }
  ]
}
